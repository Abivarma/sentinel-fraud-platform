# ============================================================
# Sentinel Fraud Platform — Environment Variables
# Copy to .env and fill values. NEVER commit .env
# ============================================================

# MinIO (S3-compatible object store)
MINIO_ROOT_USER=sentinel
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=sentinel
AWS_SECRET_ACCESS_KEY=changeme_minio
S3_BUCKET=lake

# Spark
SPARK_MASTER=spark://spark-master:7077
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=4

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_UID=50000

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC_RAW=transactions.raw
KAFKA_TOPIC_ENRICHED=transactions.enriched
KAFKA_CONSUMER_GROUP=sentinel-streaming

# Redis (Feast online store)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis

# Feast
FEAST_REGISTRY=s3://lake/feast/registry.db

# Datasets
IEEE_CIS_DATA_DIR=/workspace/data/raw/ieee_cis
PAYSIM_DATA_DIR=/workspace/data/raw/paysim

# Kaggle (for IEEE-CIS; HuggingFace used as fallback)
# Kaggle CLI ≥2.x: generate token at https://www.kaggle.com/settings/api
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# HuggingFace
HF_TOKEN=

# Synthetic producer
PRODUCER_RATE_PER_SECOND=500
PRODUCER_FRAUD_RATE=0.015

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=sentinel-fraud

# Phase config
STREAMING_DURATION_SECONDS=120
